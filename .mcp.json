{
  "mcpServers": {
    "omniroute": {
      "command": "cmd",
      "args": [
        "/c",
        "omniroute",
        "--mcp"
      ],
      "env": {
        "OMNIROUTE_BASE_URL": "http://127.0.0.1:20128",
        "OMNIROUTE_API_KEY": "${OMNIROUTE_API_KEY}"
      }
    },
    "adobe-mcp": {
      "command": "node",
      "args": [
        "mcp-server/dist/index.js"
      ],
      "env": {
        "ADOBE_MCP_EXPORT_DIR": "S:\\Adobe_MCP\\exports"
      }
    }
  }
}